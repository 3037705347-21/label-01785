{
  "name": "ai-browser-automation",
  "version": "1.0.0",
  "description": "可视化AI自动化浏览器 - 用自然语言驱动浏览器执行任务",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "vite",
    "dev:electron": "npm run build:electron && concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "vue-tsc && vite build && npm run build:electron",
    "build:web": "vue-tsc && vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "electron:start": "npm run build:electron && electron .",
    "preview": "vite preview",
    "server": "node server/index.js",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "vue": "^3.4.21",
    "vue-router": "^4.3.0",
    "pinia": "^2.1.7",
    "element-plus": "^2.6.1",
    "@element-plus/icons-vue": "^2.3.1",
    "axios": "^1.6.7",
    "puppeteer": "^22.4.1",
    "puppeteer-core": "^22.4.1",
    "express": "^4.18.3",
    "cors": "^2.8.5",
    "ws": "^8.16.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.4",
    "vite": "^5.1.6",
    "typescript": "^5.4.2",
    "vue-tsc": "^2.0.6",
    "electron": "^29.1.0",
    "electron-builder": "^24.13.3",
    "concurrently": "^8.2.2",
    "wait-on": "^7.2.0",
    "sass": "^1.71.1",
    "@types/node": "^20.11.25",
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/ws": "^8.5.10",
    "@types/uuid": "^9.0.8"
  },
  "build": {
    "appId": "com.ai.browser.automation",
    "productName": "AI Browser Automation",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "mac": {
      "target": ["dmg", "zip"]
    },
    "win": {
      "target": ["nsis", "zip"]
    },
    "linux": {
      "target": ["AppImage", "deb"]
    }
  }
}
