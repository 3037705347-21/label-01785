!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~
*.sublime-workspace
*.sublime-project

# ==================== 操作系统文件 ====================
.DS_Store
**/.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# ==================== 日志文件 ====================
logs/
**/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ==================== 测试和覆盖率 ====================
coverage/
**/coverage/
.nyc_output/
**/.nyc_output/

# ==================== 临时文件 ====================
*.tmp
*.temp
.cache/
**/.cache/
tmp/
**/tmp/
temp/
**/temp/

