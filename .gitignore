**/node_modules/

# 构建输出
dist/
**/dist/
build/
**/build/
out/
**/out/

# 环境变量文件
.env
.env.local
.env.*.local
**/.env
**/.env.local
**/.env.*.local

# ==================== IDE 和编辑器 ====================
